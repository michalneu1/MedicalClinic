meta {
  name: Ten sam termin drugi raz
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/visits
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  {
    "doctorId": {{doktorId}},
    "startsAt": "{{dzien}}T08:00:00",
    "endsAt": "{{dzien}}T08:30:00"
  }
}

assert {
  res.status: eq 409
}

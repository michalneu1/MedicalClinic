meta {
  name: Slot u nieistniejącego doktora
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/visits
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  {
    "doctorId": 999999,
    "startsAt": "{{dzien}}T09:00:00",
    "endsAt": "{{dzien}}T09:30:00"
  }
}

assert {
  res.status: eq 404
}

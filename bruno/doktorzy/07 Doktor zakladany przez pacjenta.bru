meta {
  name: Doktor zakładany przez pacjenta
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/doctors
  body: json
  auth: bearer
}

auth:bearer {
  token: {{pacjentToken}}
}

body:json {
  {
    "userId": {{kontoDoktoraId}},
    "firstName": "Tomasz",
    "lastName": "Kamiński",
    "specialization": "DERMATOLOGIST"
  }
}

assert {
  res.status: eq 403
}

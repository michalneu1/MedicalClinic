meta {
  name: Doktor na koncie
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/doctors
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  {
    "userId": {{kontoDoktoraId}},
    "firstName": "Tomasz",
    "lastName": "Kamiński",
    "specialization": "DERMATOLOGIST"
  }
}

assert {
  res.status: eq 201
  res.body.specialization: eq DERMATOLOGIST
}

script:post-response {
  bru.setVar("nowyDoktorId", res.body.id);
}

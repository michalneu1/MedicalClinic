meta {
  name: Drugi doktor na to samo konto
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/doctors
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  {
    "userId": {{kontoDoktoraId}},
    "firstName": "Tomasz",
    "lastName": "Kamiński",
    "specialization": "DERMATOLOGIST"
  }
}

assert {
  res.status: eq 409
}

meta {
  name: Lista pacjentów
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/patients
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

assert {
  res.status: eq 200
}

tests {
  test("lista zawiera nowego pacjenta", function () {
    expect(res.body.map(p => p.id)).to.include(bru.getVar("patientId"));
  });
}

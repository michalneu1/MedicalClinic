meta {
  name: Wizyty pacjenta bez wizyt
  type: http
  seq: 29
}

get {
  url: {{baseUrl}}/patients/{{patientId}}/visits
  body: none
  auth: bearer
}

auth:bearer {
  token: {{pacjentToken}}
}

assert {
  res.status: eq 200
}

tests {
  test("pusta lista", function () {
    expect(res.body).to.be.an("array").that.is.empty;
  });
}

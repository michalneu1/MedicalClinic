meta {
  name: Doktor zastępca
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/doctors
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  {
    "userId": {{kontoZastepcyId}},
    "firstName": "Adam",
    "lastName": "Zastępca",
    "specialization": "CARDIOLOGIST"
  }
}

assert {
  res.status: eq 201
}

script:post-response {
  bru.setVar("zastepcaId", res.body.id);
}

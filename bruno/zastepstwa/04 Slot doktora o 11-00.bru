meta {
  name: Slot doktora o 11-00
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/visits
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  {
    "doctorId": {{doktorId}},
    "startsAt": "{{dzien}}T11:00:00",
    "endsAt": "{{dzien}}T11:30:00"
  }
}

assert {
  res.status: eq 201
}

script:post-response {
  bru.setVar("wizyta2Id", res.body.id);
}

meta {
  name: Wizyty po zastępstwie
  type: http
  seq: 13
}

get {
  url: {{baseUrl}}/visits?doctorId={{zastepcaId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{pacjentToken}}
}

assert {
  res.status: eq 200
}

tests {
  test("zastepowany doktor nie ma juz wizyt", function () {
    expect(res.body).to.be.an("array").that.is.empty;
  });
}

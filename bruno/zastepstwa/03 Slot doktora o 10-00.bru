meta {
  name: Slot doktora o 10-00
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/visits
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  {
    "doctorId": {{doktorId}},
    "startsAt": "{{dzien}}T10:00:00",
    "endsAt": "{{dzien}}T10:30:00"
  }
}

assert {
  res.status: eq 201
}

script:post-response {
  bru.setVar("wizyta1Id", res.body.id);
}

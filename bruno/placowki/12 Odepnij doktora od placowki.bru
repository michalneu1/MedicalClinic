meta {
  name: Odepnij doktora od placówki
  type: http
  seq: 12
}

delete {
  url: {{baseUrl}}/doctors/{{doktorId}}/facilities/{{placowkaId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{doktorToken}}
}

assert {
  res.status: eq 200
}

tests {
  test("doktor nie ma juz tej placowki", function () {
    expect(res.body.facilities).to.not.include(bru.getVar("placowkaNazwa"));
  });
}
